{
    "name": "rushphp/code-tool",
    "description": "RUSH code tool. Shared-host code delivery: check, push, promote, release and rollback.",
    "type": "library",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "license": "MIT",
    "authors": [
        {
            "name": "RUSHphp",
            "homepage": "https://github.com/rushphp"
        }
    ],
    "keywords": [
        "rush",
        "cli",
        "deploy",
        "release",
        "shared-hosting",
        "automation"
    ],
    "support": {
        "issues": "https://github.com/rushphp/code-tool/issues",
        "source": "https://github.com/rushphp/code-tool"
    },
    "extra": {
        "rush": {
            "tool": "Rush\\Tool\\Code\\CodeTool"
        }
    },
    "autoload": {
        "psr-4": {
            "Rush\\Tool\\Code\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.3",
        "rushphp/contract": "^0.2",
        "rushphp/support": "^0.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "pestphp/pest": "^3.8",
        "rushphp/rush": "^0.2",
        "rushphp/testing": "^0.1"
    },
    "scripts": {
        "stan": "@php vendor/bin/phpstan analyse -c phpstan.neon",
        "test": "pest",
        "test:cover": "pest --coverage"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
